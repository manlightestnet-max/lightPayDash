{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/pay/:id", "destination": "https://checkout.smlab.xyz/pay/:id", "permanent": false },
    { "source": "/account", "destination": "https://checkout.smlab.xyz/account", "permanent": false },
    { "source": "/connect", "destination": "https://checkout.smlab.xyz/connect", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
